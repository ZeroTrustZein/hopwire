# Copy to deploy/.env and replace every value. Never commit .env.
# Generate strong values with:  openssl rand -hex 32
# (hex keeps POSTGRES_PASSWORD URL-safe; it is embedded in DATABASE_URL.)

# Bearer key for every /v1/* route (console login + hopwire-bench replay).
HOPWIRE_API_KEY=change-me

POSTGRES_DB=hopwire
POSTGRES_USER=hopwire
POSTGRES_PASSWORD=change-me-too

# Engine config file mounted at /etc/hopwire/config.toml (path relative to deploy/).
# Default: ../config.example.toml. For tuning: cp ../config.example.toml config.toml
# HOPWIRE_CONFIG_FILE=./config.toml

RUST_LOG=info
