{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "aegis-server",
      "runtimeExecutable": "cargo",
      "runtimeArgs": ["run", "--release", "-p", "aegis-server"],
      "env": {
        "DATABASE_URL": "postgres://aegis@localhost:54329/aegis",
        "AEGIS_API_KEY": "devkey",
        "AEGIS_BIND": "127.0.0.1:18080"
      },
      "port": 18080
    },
    {
      "name": "console",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--port", "5174", "--strictPort"],
      "cwd": "console",
      "env": { "AEGIS_PROXY_TARGET": "http://127.0.0.1:18080" },
      "port": 5174
    }
  ]
}
