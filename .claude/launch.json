{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hopwire-server",
      "runtimeExecutable": "cargo",
      "runtimeArgs": ["run", "--release", "-p", "hopwire-server"],
      "env": {
        "DATABASE_URL": "postgres://hopwire@localhost:54329/hopwire",
        "HOPWIRE_API_KEY": "devkey",
        "HOPWIRE_BIND": "127.0.0.1:18080"
      },
      "port": 18080
    },
    {
      "name": "console",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--port", "5174", "--strictPort"],
      "cwd": "console",
      "env": { "HOPWIRE_PROXY_TARGET": "http://127.0.0.1:18080" },
      "port": 5174
    }
  ]
}
